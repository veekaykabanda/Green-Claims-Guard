# Settings for `docker compose up`. Copy this file to .env (which git ignores) and fill it in.

# The database password. 8+ characters with upper and lower case, a digit and a symbol.
SQL_SA_PASSWORD=

# From your Auth0 tenant. These identify your app to Auth0; they are not secrets.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_AUDIENCE=https://greenclaims-api

# Optional. Without a key the rules still run and the AI check says it is not set up.
OPENAI_API_KEY=

# Optional. Set to true only while ONE person holds the Senior Editor role.
SINGLE_SENIOR_EDITOR=

# Optional. The API only accepts browser requests from this address; unset, it accepts the default
# local development addresses. docker-compose sets this for you from WEB_PORT below.
ALLOWED_WEB_ORIGINS=

# Optional. Change if 8080 or 8081 are already in use on this machine.
API_PORT=8080
WEB_PORT=8081
